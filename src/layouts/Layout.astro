const base=import.meta.env.BASE_URL;
const canonical=new URL(Astro.url.pathname,Astro.site||'https://jayyeong.github.io');
import './style.css';
---
<!doctype html><html lang="ko"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#f8f7f3"/><link rel="preload" href={`${base}fonts/portfolio-sans.woff2`} as="font" type="font/woff2" crossorigin/><link rel="canonical" href={canonical}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><title>{title}</title><link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml"/></head><body><a class="skip" href="#main">본문 바로가기</a><header class="header"><a class="wordmark" href={base}>정제영<span>JEYOUNG JEONG</span></a><nav aria-label="주 메뉴"><a href={`${base}#work`}>작업 <span>Work</span></a><a href={`${base}#about`}>소개 <span>About</span></a><a href="https://github.com/jayyeong" aria-label="정제영 GitHub">GitHub </a></nav></header><main id="main" tabindex="-1"><slot/></main><footer><a class="wordmark" href={base}>정제영<span>JEYOUNG JEONG</span></a><span>© 2026 · 생각을 실제로 만드는 일.</span><a href="#main">맨 위로 </a></footer></body></html>
